# 1. FIREBASE
# ------------------------------------------------------------------------------
# Name: Firebase Web Config
# Website to get keys: https://console.firebase.google.com/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_google_analytics_measurement_id

# ------------------------------------------------------------------------------
# 2. GEMINI API
# ------------------------------------------------------------------------------
# Name: Gemini API Key
# Website to get key: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. IMGBB API
# ------------------------------------------------------------------------------
# Name: ImgBB API Key
# Website to get key: https://api.imgbb.com/
# ------------------------------------------------------------------------------
IMGBB_API_KEY=your_imgbb_api_key_here

